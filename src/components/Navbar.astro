---
import Logo from './Logo.astro';

const links = [
  { label: 'Problem', href: '#problem' },
  { label: 'Technology', href: '#technology' },
  { label: 'Science', href: '#science' },
  { label: 'Market', href: '#market' },
  { label: 'Roadmap', href: '#roadmap' },
  { label: 'Team', href: '#team' },
];
---

<header id="navbar" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
  <nav
    class="nav-shell mx-auto flex h-14 max-w-page items-center justify-between rounded-full border border-transparent px-3 pl-4 transition-all duration-500"
    aria-label="Primary"
  >
    <a href="#hero" class="flex items-center gap-2.5" aria-label="NeuroFarm home">
      <Logo class="h-7 w-7" />
      <span class="text-[0.95rem] font-semibold tracking-tight">NeuroFarm</span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {links.map(({ label, href }) => (
        <a
          href={href}
          data-nav={href.slice(1)}
          class="nav-link rounded-full px-3.5 py-2 text-sm text-nf-muted transition-colors duration-200 hover:text-nf-text"
        >
          {label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href="#contact" class="btn-primary hidden !min-h-[40px] !px-5 !text-sm sm:inline-flex">
        Investor enquiries
      </a>
      <button
        id="mobile-menu-btn"
        class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-nf-text lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path class="menu-open" stroke-linecap="round" d="M4 8h16M4 16h16" />
          <path class="menu-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="mx-auto mt-2 hidden max-w-page rounded-3xl border border-white/10 bg-nf-deep/95 p-3 backdrop-blur-xl lg:hidden"
  >
    {links.map(({ label, href }) => (
      <a href={href} class="mobile-link block rounded-2xl px-4 py-3 text-nf-text hover:bg-white/5">{label}</a>
    ))}
    <a href="#contact" class="mobile-link btn-primary mt-2 w-full">Investor enquiries</a>
  </div>
</header>

<style>
  .nav-shell.is-scrolled {
    background: rgba(10, 21, 16, 0.72);
    border-color: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.6);
  }
  .nav-link.is-active {
    color: theme('colors.nf.text');
    background: rgba(255, 255, 255, 0.06);
  }
</style>

<script>
  const shell = document.querySelector('.nav-shell')!;
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => shell.classList.toggle('is-scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setMenu = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.menu-open')!.classList.toggle('hidden', open);
    btn.querySelector('.menu-close')!.classList.toggle('hidden', !open);
  };
  btn.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
  menu.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

  // Active section indicator
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((l) => l.classList.toggle('is-active', l.dataset.nav === entry.target.id));
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((l) => {
    const target = document.getElementById(l.dataset.nav!);
    if (target) observer.observe(target);
  });
</script>
