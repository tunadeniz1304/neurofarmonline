---
/**
 * Illustrative, interactive view of the closed loop under the four stress
 * scenarios NeuroFarm trains and evaluates on. Values are illustrative only.
 */
const scenarios = [
  {
    id: 'nominal',
    name: 'Nominal',
    blurb: 'Healthy growth conditions. The policy keeps inputs lean and steady.',
    sensors: [0.52, 0.55, 0.7, 0.62, 0.5],
    actions: [0.3, 0.72, 0.35],
    rate: 0.35,
  },
  {
    id: 'drought',
    name: 'Drought',
    blurb: 'Soil moisture collapses. Irrigation ramps up before the plant shows stress.',
    sensors: [0.14, 0.72, 0.78, 0.6, 0.66],
    actions: [0.88, 0.6, 0.18],
    rate: 0.8,
  },
  {
    id: 'over',
    name: 'Over-irrigation',
    blurb: 'Waterlogged root zone. Irrigation and dosing back off to protect the roots.',
    sensors: [0.92, 0.5, 0.62, 0.58, 0.3],
    actions: [0.04, 0.66, 0.12],
    rate: 0.6,
  },
  {
    id: 'co2',
    name: 'CO₂ drop',
    blurb: 'Carbon falls and photosynthesis stalls. Light is rebalanced so energy is not wasted.',
    sensors: [0.5, 0.52, 0.66, 0.16, 0.52],
    actions: [0.28, 0.38, 0.3],
    rate: 0.55,
  },
];
const sensorNames = ['Soil moisture', 'Air temp / RH', 'Light (PPFD)', 'CO₂', 'Soil EC'];
const actionNames = ['Irrigation pump', 'LED intensity', 'Nutrient dosing'];
---

<section id="demo" class="section pt-0">
  <div class="page">
    <div class="card overflow-hidden !rounded-[28px]" data-reveal>
      <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
        <!-- Controls -->
        <div class="border-b border-white/[0.06] p-7 md:p-10 lg:border-b-0 lg:border-r">
          <span class="eyebrow">Closed loop</span>
          <h2 class="mt-5 text-3xl font-medium tracking-tightest md:text-4xl">
            Stress it. <span class="accent-serif">Watch it adapt.</span>
          </h2>
          <p class="mt-4 leading-relaxed text-nf-muted">
            The controller is trained and evaluated under four scenarios. Pick one to see how sensor readings become
            spikes and spikes become actions.
          </p>

          <div class="mt-8 grid grid-cols-2 gap-2" role="tablist" aria-label="Scenario">
            {scenarios.map((s, i) => (
              <button
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-scenario={s.id}
                class="scenario-tab min-h-[48px] cursor-pointer rounded-xl border border-white/10 px-4 text-left text-sm text-nf-muted transition-all duration-200 hover:border-white/25 hover:text-nf-text"
              >
                {s.name}
              </button>
            ))}
          </div>

          <p id="scenario-blurb" class="mt-6 min-h-[3.5rem] text-sm leading-relaxed text-nf-text" aria-live="polite">
            {scenarios[0].blurb}
          </p>

          <div class="mt-6 space-y-3">
            {sensorNames.map((name, i) => (
              <div>
                <div class="flex justify-between font-mono text-[0.7rem] uppercase tracking-wider text-nf-dim">
                  <span>{name}</span>
                  <span data-sensor-val={i}></span>
                </div>
                <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-white/[0.06]">
                  <div data-sensor={i} class="bar h-full rounded-full bg-nf-leaf" style={`width:${scenarios[0].sensors[i] * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Visual -->
        <div class="relative flex flex-col bg-gradient-to-b from-nf-deep/60 to-transparent p-7 md:p-10">
          <div class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">
            <span>Spike raster · hidden layer</span>
            <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 animate-pulse rounded-full bg-nf-signal"></span>live</span>
          </div>
          <canvas id="raster" class="mt-4 h-56 w-full md:h-64" aria-hidden="true"></canvas>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {actionNames.map((name, i) => (
              <div class="rounded-2xl border border-white/[0.07] bg-nf-ink/60 p-4">
                <div class="font-mono text-[0.66rem] uppercase tracking-wider text-nf-dim">A{i + 1} · {name}</div>
                <div class="mt-3 font-mono text-3xl text-nf-text"><span data-action-val={i}>{Math.round(scenarios[0].actions[i] * 100)}</span><span class="text-base text-nf-dim">%</span></div>
                <div class="mt-3 h-1 overflow-hidden rounded-full bg-white/[0.06]">
                  <div data-action={i} class="bar h-full rounded-full bg-nf-signal" style={`width:${scenarios[0].actions[i] * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
          <p class="mt-6 font-mono text-[0.66rem] leading-relaxed text-nf-dim">
            Illustrative visualisation of the control loop — not measured results.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bar {
    transition: width 0.9s var(--ease-out);
  }
  .scenario-tab[aria-selected='true'] {
    border-color: rgba(196, 243, 107, 0.55);
    background: rgba(196, 243, 107, 0.08);
    color: theme('colors.nf.text');
  }
</style>

<script define:vars={{ scenarios }}>
  const tabs = document.querySelectorAll('[data-scenario]');
  const blurb = document.getElementById('scenario-blurb');
  const canvas = document.getElementById('raster');
  const ctx = canvas.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = scenarios[0];

  function apply(s) {
    current = s;
    blurb.textContent = s.blurb;
    s.sensors.forEach((v, i) => {
      document.querySelector(`[data-sensor="${i}"]`).style.width = `${v * 100}%`;
      document.querySelector(`[data-sensor-val="${i}"]`).textContent = v.toFixed(2);
    });
    s.actions.forEach((v, i) => {
      document.querySelector(`[data-action="${i}"]`).style.width = `${v * 100}%`;
      document.querySelector(`[data-action-val="${i}"]`).textContent = Math.round(v * 100);
    });
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.scenario === s.id)));
  }

  tabs.forEach((t, idx) => {
    t.addEventListener('click', () => apply(scenarios.find((s) => s.id === t.dataset.scenario)));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(idx + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      next.click();
    });
  });
  apply(current);

  // Spike raster: 16 hidden neurons scrolling in time
  const N = 16;
  let cols = [];
  let w = 0;
  let h = 0;
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const r = canvas.getBoundingClientRect();
    w = r.width;
    h = r.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = [];
    const n = Math.floor(w / 6);
    for (let i = 0; i < n; i++) cols.push(makeCol());
    draw();
  }
  function makeCol() {
    return Array.from({ length: N }, (_, j) => Math.random() < current.rate * (0.25 + 0.75 * ((j * 7) % N) / N) * 0.45);
  }
  function draw() {
    ctx.clearRect(0, 0, w, h);
    const rowH = h / N;
    for (let j = 0; j < N; j++) {
      ctx.fillStyle = 'rgba(255,255,255,0.03)';
      ctx.fillRect(0, j * rowH + rowH / 2, w, 1);
    }
    cols.forEach((col, x) => {
      const age = x / cols.length;
      col.forEach((on, j) => {
        if (!on) return;
        ctx.fillStyle = `rgba(196,243,107,${0.15 + 0.85 * age})`;
        ctx.fillRect(x * 6, j * rowH + 3, 2, rowH - 6);
      });
    });
  }
  let t = 0;
  let running = false;
  function loop(now) {
    if (!running) return;
    if (now - t > 70) {
      t = now;
      cols.shift();
      cols.push(makeCol());
      draw();
    }
    requestAnimationFrame(loop);
  }
  new ResizeObserver(resize).observe(canvas);
  new IntersectionObserver(([e]) => {
    running = e.isIntersecting && !reduced;
    if (running) requestAnimationFrame(loop);
  }).observe(canvas);
</script>
