---
const problems = [
  {
    k: '01',
    title: 'Brittle rule stacks',
    body: 'Greenhouses are packed with sensors, yet control stays conservative: hand-tuned thresholds, fixed LED schedules and PID loops that cannot adapt to a plant that changes every day.',
  },
  {
    k: '02',
    title: 'A rising footprint',
    body: 'Indoor and vertical farming keep pushing up water and energy use per kilogram of biomass — the exact metrics growers and regulators are now measured on.',
  },
  {
    k: '03',
    title: 'Cloud-shaped AI',
    body: 'Most “AI in agriculture” bolts cloud models on top of the rules. That adds latency, bandwidth and energy, and fails where connectivity is weakest: in the field.',
  },
];

const rules = [
  ['if', 'soil_moisture < 0.32:', 'pump.on(seconds=90)'],
  ['elif', 'soil_moisture > 0.55:', 'pump.off()'],
  ['if', '6 <= hour < 22:', 'led.set(0.80)'],
  ['if', 'co2_ppm < 800:', 'alert("check CO2")'],
  ['if', 'ec > 2.4:', 'dosing.pause()'],
  ['', 'pid.update(setpoint, err, dt)', ''],
];
---

<section id="problem" class="section">
  <div class="page">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow">The problem</span>
      <h2 class="h2 mt-6">
        Agriculture still runs on <span class="accent-serif">if / else.</span>
      </h2>
      <p class="lede mt-6">
        Precision farming has the sensors. What it lacks is a controller that actually learns — and can run where
        the plants are, without a data centre behind it.
      </p>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:gap-10">
      <!-- Code morph -->
      <div class="card overflow-hidden" data-reveal>
        <div class="flex items-center gap-2 border-b border-white/[0.06] px-5 py-3.5">
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="ml-3 font-mono text-xs text-nf-dim">greenhouse_controller.py</span>
        </div>
        <div class="code-morph relative p-5 font-mono text-[0.72rem] leading-7 sm:p-6 sm:text-[0.86rem]" id="code-morph">
          <div class="mb-3 text-nf-dim"># today: a stack of heuristics</div>
          {rules.map(([kw, cond, act], i) => (
            <div class="rule-line whitespace-nowrap" style={`--r:${i}`}>
              {kw && <span class="text-nf-coral">{kw} </span>}
              <span class="text-nf-muted">{cond}</span>
              {act && <span class="text-nf-text"> {act}</span>}
            </div>
          ))}
          <div class="policy-line mt-5 border-t border-dashed border-white/10 pt-5">
            <div class="text-nf-dim"># NeuroFarm: one learned policy, on-chip</div>
            <div class="mt-1 text-[0.95rem] sm:text-base">
              <span class="text-nf-text">actions</span>
              <span class="text-nf-dim"> = </span>
              <span class="text-nf-signal">snn</span><span class="text-nf-text">(sensors)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Problems -->
      <div class="flex flex-col gap-4">
        {problems.map((p, i) => (
          <article class="card group p-6 transition-colors duration-300 hover:border-white/15 md:p-7" data-reveal style={`--d:${i * 90}ms`}>
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-xs text-nf-dim">{p.k}</span>
              <div>
                <h3 class="text-lg font-medium tracking-tight">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-nf-muted">{p.body}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .rule-line {
    transition: opacity 0.6s ease, filter 0.6s ease;
    transition-delay: calc(var(--r) * 90ms);
    position: relative;
    width: fit-content;
  }
  .rule-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    height: 1px;
    width: 100%;
    background: theme('colors.nf.coral');
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
    transition-delay: calc(var(--r) * 90ms + 400ms);
  }
  .policy-line {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.8s var(--ease-out) 1.3s, transform 0.8s var(--ease-out) 1.3s;
  }
  .code-morph.is-in .rule-line {
    opacity: 0.45;
  }
  .code-morph.is-in .rule-line::after {
    transform: scaleX(1);
  }
  .code-morph.is-in .policy-line {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 480px) {
    .code-morph {
      overflow-x: auto;
    }
  }
</style>

<script>
  const el = document.getElementById('code-morph');
  if (el) {
    new IntersectionObserver(
      ([entry], obs) => {
        if (entry.isIntersecting) {
          el.classList.add('is-in');
          obs.disconnect();
        }
      },
      { threshold: 0.6 },
    ).observe(el);
  }
</script>
