---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { team } from '../../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.{png,jpg,jpeg,webp}', { eager: true });
const photoFor = (slug: string) => {
  const match = Object.entries(photos).find(([path]) => path.includes(`/${slug}.`));
  if (!match) throw new Error(`Missing team photo for "${slug}" in src/assets/team/`);
  return match[1].default;
};
---

<section class="section" id="team" aria-labelledby="team-title">
  <div class="wrap grid">
    <div class="reveal">
      <SectionHeading eyebrow="06 — Team" id="team-title">
        One founder on the silicon. <em>One on the market.</em>
        <p class="note" slot="after">Accepted into the VU Amsterdam Demonstrator Lab (D-Lab) in February 2026.</p>
      </SectionHeading>
    </div>
    <div class="people">
      {
        team.map((person) => (
          <article class:list={['person', 'reveal', person.tone]}>
            <div class="photo">
              <Image
                src={photoFor(person.photo)}
                alt={`Portrait of ${person.name}`}
                widths={[320, 480]}
                sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 360px"
                format="webp"
                loading="lazy"
              />
            </div>
            <div class="body">
              <h3>{person.name}</h3>
              <p class="role">{person.role}</p>
              <p class="focus">{person.focus}</p>
              <a class="text-link" href={person.linkedin} target="_blank" rel="noopener">
                LinkedIn <span aria-hidden="true">↗</span>
                <span class="sr-only"> — {person.name} (opens in a new tab)</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .note {
    color: var(--muted);
  }
  .people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .person {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .photo {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--surface);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.4s ease;
  }
  .person:hover .photo :global(img),
  .person:focus-within .photo :global(img) {
    filter: grayscale(0);
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: var(--accent);
  }
  .amber .photo::after {
    background: var(--amber);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 12px;
    padding: clamp(20px, 2.4vw, 28px);
  }
  h3 {
    font-size: 24px;
    font-weight: 600;
  }
  .role {
    color: var(--accent);
  }
  .amber .role {
    color: var(--amber);
  }
  .focus {
    color: var(--muted);
    line-height: 1.6;
  }
  .body a {
    margin-top: auto;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
