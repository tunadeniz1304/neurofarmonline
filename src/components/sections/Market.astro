---
import SectionHeading from '../ui/SectionHeading.astro';
import { marketPath, markets, tailwinds } from '../../data/site';
---

<section class="section" id="market" aria-labelledby="market-title">
  <div class="wrap stack" style="gap: 72px">
    <div class="grid">
      <div class="stack reveal" style="gap: 40px">
        <SectionHeading eyebrow="05 — Market" id="market-title">
          Start indoors. Then greenhouses. <em>Then the open field.</em>
        </SectionHeading>
        <ol class="steps">
          {
            marketPath.map((step, i) => (
              <li>
                <span class="n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <figure class="venn reveal">
        <div
          class="venn-box"
          role="img"
          aria-label={`Conceptual diagram: NeuroFarm sits at the intersection of ${markets.join(', ')}.`}>
          <span class="c c1"></span>
          <span class="c c2"></span>
          <span class="c c3"></span>
          <span class="l l1" aria-hidden="true">{markets[0]}</span>
          <span class="l l2" aria-hidden="true">{markets[1]}</span>
          <span class="l l3" aria-hidden="true">{markets[2]}</span>
          <span class="core" aria-hidden="true">NeuroFarm</span>
        </div>
        <figcaption class="mono label">Conceptual — not to scale</figcaption>
      </figure>
    </div>

    <div class="reveal">
      <h3 class="mono label tw-title">Tailwinds</h3>
      <ul class="tailwinds">{tailwinds.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--line-2);
  }
  .steps li:last-child {
    border-bottom: 1px solid var(--line-2);
  }
  .n {
    font-family: var(--serif);
    font-size: 32px;
    line-height: 1;
    color: var(--accent);
  }
  .steps h3 {
    font-size: 20px;
    font-weight: 600;
  }
  .steps p {
    margin-top: 4px;
    color: var(--muted);
  }

  .venn {
    width: min(100%, 500px);
    margin-inline: auto;
  }
  .venn-box {
    position: relative;
    width: 100%;
    aspect-ratio: 500 / 460;
  }
  .c {
    position: absolute;
    width: 58%;
    height: 63.04%;
    border-radius: 50%;
    border: 1.5px solid var(--border);
  }
  .c1 {
    left: 4%;
    top: 0;
    background: rgb(198 243 107 / 0.05);
  }
  .c2 {
    left: 38%;
    top: 0;
    background: rgb(245 182 80 / 0.05);
  }
  .c3 {
    left: 21%;
    top: 32.6%;
    background: rgb(237 240 231 / 0.04);
  }
  .l {
    position: absolute;
    font-size: clamp(13px, 1.3vw, 16px);
    line-height: 1.3;
    color: var(--text-2);
  }
  .l1 {
    left: 9%;
    top: 20%;
    width: 27%;
  }
  .l2 {
    left: 66%;
    top: 20%;
    width: 26%;
    text-align: right;
  }
  .l3 {
    left: 30%;
    top: 80%;
    width: 40%;
    text-align: center;
  }
  .core {
    position: absolute;
    left: 37%;
    top: 42%;
    width: 26%;
    padding: 6px 0;
    background: var(--accent);
    color: var(--ground);
    font-family: var(--serif);
    font-size: clamp(18px, 2vw, 24px);
    text-align: center;
  }
  .venn figcaption {
    margin-top: 14px;
    text-align: center;
  }

  .tw-title {
    font-weight: 400;
  }
  .tailwinds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 22px;
  }
  .tailwinds li {
    padding: 24px;
    background: var(--surface);
    font-size: 17px;
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .tailwinds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .steps li {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 12px;
      padding: 16px 0;
    }
    .n {
      font-size: 28px;
    }
    .tailwinds {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .tailwinds li {
      padding: 16px 18px;
      font-size: 15px;
    }
  }
</style>
