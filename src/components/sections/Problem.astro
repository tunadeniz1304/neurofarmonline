---
import SectionHeading from '../ui/SectionHeading.astro';
import { controlToday, problems } from '../../data/site';
---

<section class="section" id="problem" aria-labelledby="problem-title">
  <div class="wrap stack" style="gap: 64px">
    <div class="reveal">
      <SectionHeading eyebrow="01 — The problem" id="problem-title">
        Greenhouses are full of sensors. Their control is still <em>hand-written rules.</em>
      </SectionHeading>
    </div>

    <div class="cards">
      {
        problems.map((p, i) => (
          <div class="card reveal">
            <span class="num">1.{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="compare reveal" role="group" aria-label="Control path today compared with NeuroFarm">
      <div class="row">
        <span class="row-label mono">Today</span>
        <div class="flow">
          {
            controlToday.map((step, i) => (
              <>
                {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
                <span class="box">{step}</span>
              </>
            ))
          }
        </div>
      </div>
      <div class="divider"></div>
      <div class="row nf">
        <span class="row-label mono">NeuroFarm</span>
        <div class="flow">
          <span class="box">5 sensors</span>
          <span class="arrow" aria-hidden="true">→</span>
          <span class="box core">One spiking network, on-site, on a neuromorphic chip</span>
          <span class="arrow" aria-hidden="true">→</span>
          <span class="box">3 actuators</span>
          <span class="note mono">No internet · no rules in the loop</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--line-2);
  }
  .num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--faint);
  }
  h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
  }
  .card p {
    color: var(--muted);
    line-height: 1.6;
  }

  .compare {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }
  .row-label {
    color: var(--muted);
  }
  .nf .row-label {
    color: var(--accent);
  }
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--text-2);
  }
  .box {
    padding: 13px 16px;
    border: 1px dashed var(--border);
  }
  .arrow {
    color: var(--faint);
  }
  .nf .flow {
    color: var(--text);
  }
  .nf .box {
    border-style: solid;
  }
  .nf .core {
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }
  .nf .arrow {
    color: var(--accent);
  }
  .note {
    margin-left: auto;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .card {
      padding-top: 20px;
    }
    h3 {
      font-size: 21px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .flow {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .arrow {
      align-self: center;
      transform: rotate(90deg);
    }
    .note {
      margin: 6px 0 0;
    }
  }
</style>
