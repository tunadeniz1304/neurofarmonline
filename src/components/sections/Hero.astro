---
import ClosedLoopFigure from '../figures/ClosedLoopFigure.astro';
import { heroSpecs } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="kicker">Closed-loop crop control · Neuromorphic edge AI · Amsterdam</p>
      <h1 class="title" id="hero-title">The <em>offline</em> brain for agriculture.</h1>
      <p class="sub">
        NeuroFarm controls irrigation, lighting and nutrients with a single spiking neural network — trained with
        reinforcement learning, running on neuromorphic hardware right next to the plant. No cloud. No hand-written rules.
        Every actuator command is one forward pass.
      </p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href="#contact">Request the investor brief <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost btn-lg" href="#system">See how it works</a>
      </div>
      <dl class="specs">
        {
          heroSpecs.map((spec) => (
            <div>
              <dt>{spec.label}</dt>
              <dd>
                {spec.value}
                {'note' in spec && <small>{spec.note}</small>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <ClosedLoopFigure />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 88px) clamp(56px, 7vw, 96px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kicker::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(58px, 8vw, 116px);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .title em {
    color: var(--accent);
  }
  .sub {
    max-width: 590px;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.52;
    color: var(--text-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 8px;
    border-top: 1px solid var(--line-soft);
  }
  .specs > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 14px 0 0;
  }
  .specs dt {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .specs dd {
    font-family: var(--serif);
    font-size: clamp(30px, 2.6vw, 36px);
    line-height: 1.05;
  }
  .specs small {
    display: block;
    margin-top: 2px;
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .specs > div {
      padding: 16px 12px 16px 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .ctas {
      flex-direction: column;
    }
    .ctas .btn {
      width: 100%;
    }
  }
</style>
