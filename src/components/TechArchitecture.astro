---
const pipeline = [
  {
    k: '01',
    title: 'Simulate',
    tag: 'Digital twin',
    body: 'Van Henten lettuce growth model coupled to a 5-state climate model, with 47 crop parameters each traced to a peer-reviewed source.',
  },
  {
    k: '02',
    title: 'Learn',
    tag: 'Soft Actor-Critic',
    body: 'A reinforcement-learning agent learns the control policy across nominal, drought, over-irrigation and CO₂-drop scenarios.',
  },
  {
    k: '03',
    title: 'Distil',
    tag: '5 → 32 → 16 → 3',
    body: 'The policy is distilled into a compact student network small enough to live entirely on a microchip.',
  },
  {
    k: '04',
    title: 'Quantise',
    tag: '8 / 4 / 4-bit',
    body: 'QuantizeML compresses weights and activations for neuromorphic hardware with minimal loss.',
  },
  {
    k: '05',
    title: 'Deploy',
    tag: 'Akida SNN',
    body: 'Converted to a spiking neural network and executed on BrainChip Akida silicon, next to the crop.',
  },
];

const specs = [
  { value: '7,259', unit: '', label: 'Parameters', note: 'Whole policy fits in on-chip memory' },
  { value: '8,760', unit: '', label: 'MACs per decision', note: 'Orders of magnitude below vision-scale models' },
  { value: '~50', unit: '%', label: 'Activation sparsity', note: 'Silent neurons cost ~nothing on event-driven silicon' },
  { value: '288', unit: '/day', label: 'Closed-loop decisions', note: 'One policy inference every 5 minutes' },
];

const compare = [
  ['Where decisions happen', 'Remote data centre', 'On the node, next to the plant'],
  ['Needs connectivity', 'Always', 'Never'],
  ['Control logic', 'ML layered on thresholds & PID', 'One learned policy, end to end'],
  ['Compute model', 'Dense, clocked matrix maths', 'Sparse, event-driven spikes'],
  ['Farm data leaves site', 'Continuously', 'Not required'],
];
---

<section id="technology" class="section overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px hairline" aria-hidden="true"></div>
  <div class="page">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div data-reveal>
        <span class="eyebrow">Technology</span>
        <h2 class="h2 mt-6">
          From reinforcement learning <span class="accent-serif">to silicon.</span>
        </h2>
      </div>
      <p class="lede lg:pb-2" data-reveal style="--d:100ms">
        NeuroFarm's controller is trained in a scientifically grounded digital twin, then compressed into a spiking
        neural network that runs on neuromorphic hardware. Every actuator command comes from a single forward pass —
        <span class="text-nf-text">no thresholds, no PID, no hand-written rules</span> in the control path.
      </p>
    </div>

    <!-- Pipeline -->
    <ol class="relative mt-16 grid gap-3 md:grid-cols-5">
      <div class="pipe-line pointer-events-none absolute left-0 right-0 top-[2.25rem] hidden h-px md:block" aria-hidden="true"></div>
      {pipeline.map((step, i) => (
        <li class="card group relative p-5 transition-colors duration-300 hover:border-nf-signal/30" data-reveal style={`--d:${i * 80}ms`}>
          <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-nf-ink font-mono text-[0.7rem] text-nf-signal transition-colors group-hover:border-nf-signal/50">
            {step.k}
          </span>
          <h3 class="mt-6 text-xl font-medium tracking-tight">{step.title}</h3>
          <div class="mt-1 font-mono text-[0.66rem] uppercase tracking-wider text-nf-dim">{step.tag}</div>
          <p class="mt-2 text-sm leading-relaxed text-nf-muted">{step.body}</p>
        </li>
      ))}
    </ol>

    <!-- Specs bento -->
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {specs.map((s, i) => (
        <div class="card p-6" data-reveal style={`--d:${i * 80}ms`}>
          <div class="text-sm text-nf-muted">{s.label}</div>
          <div class="mt-4 font-mono text-4xl font-medium tracking-tight text-nf-text md:text-[2.75rem]">
            <span data-count={s.value}>{s.value}</span><span class="text-nf-signal">{s.unit}</span>
          </div>
          <div class="mt-3 text-sm text-nf-dim">{s.note}</div>
        </div>
      ))}
    </div>

    <div class="mt-3 grid gap-3 lg:grid-cols-[1fr_1.4fr]">
      <!-- Hardware -->
      <div class="card relative overflow-hidden p-7" data-reveal>
        <div class="chip-art pointer-events-none absolute -right-10 -top-10 h-56 w-56 opacity-60" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="none" class="h-full w-full">
            <rect x="50" y="50" width="100" height="100" rx="14" stroke="rgba(196,243,107,0.5)" />
            <rect x="72" y="72" width="56" height="56" rx="8" fill="rgba(196,243,107,0.08)" stroke="rgba(196,243,107,0.35)" />
            {Array.from({ length: 7 }).map((_, i) => (
              <g stroke="rgba(255,255,255,0.18)">
                <line x1={62 + i * 13} y1="50" x2={62 + i * 13} y2="30" />
                <line x1={62 + i * 13} y1="150" x2={62 + i * 13} y2="170" />
                <line x1="50" y1={62 + i * 13} x2="30" y2={62 + i * 13} />
                <line x1="150" y1={62 + i * 13} x2="170" y2={62 + i * 13} />
              </g>
            ))}
          </svg>
        </div>
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">Edge node · Phase 1 hardware</span>
        <h3 class="mt-4 max-w-xs text-2xl font-medium tracking-tight">A full AI controller in the palm of your hand.</h3>
        <ul class="mt-6 space-y-3 text-sm">
          <li class="flex gap-3"><span class="mt-2 h-1 w-1 flex-none rounded-full bg-nf-signal"></span><span><span class="text-nf-text">BrainChip Akida AKD1000</span> <span class="text-nf-muted">— event-driven neuromorphic processor</span></span></li>
          <li class="flex gap-3"><span class="mt-2 h-1 w-1 flex-none rounded-full bg-nf-signal"></span><span><span class="text-nf-text">Raspberry Pi 5 host</span> <span class="text-nf-muted">— sensor I/O and actuator drivers</span></span></li>
          <li class="flex gap-3"><span class="mt-2 h-1 w-1 flex-none rounded-full bg-nf-signal"></span><span><span class="text-nf-text">Inline power metering</span> <span class="text-nf-muted">— every joule measured on real silicon</span></span></li>
        </ul>
      </div>

      <!-- Edge vs cloud -->
      <div class="card overflow-hidden" data-reveal style="--d:100ms">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Cloud-based agricultural AI compared with NeuroFarm edge control</caption>
          <thead>
            <tr class="border-b border-white/[0.07]">
              <th scope="col" class="px-5 py-4 font-normal text-nf-dim md:px-6"></th>
              <th scope="col" class="px-3 py-4 font-mono text-[0.7rem] font-normal uppercase tracking-wider text-nf-dim">Cloud AgTech</th>
              <th scope="col" class="px-3 py-4 font-mono text-[0.7rem] font-normal uppercase tracking-wider text-nf-signal md:pr-6">NeuroFarm</th>
            </tr>
          </thead>
          <tbody>
            {compare.map(([row, cloud, nf]) => (
              <tr class="border-b border-white/[0.05] last:border-0">
                <th scope="row" class="px-5 py-4 font-normal text-nf-muted md:px-6">{row}</th>
                <td class="px-3 py-4 text-nf-dim">{cloud}</td>
                <td class="px-3 py-4 text-nf-text md:pr-6">{nf}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-5 font-mono text-[0.7rem] leading-relaxed text-nf-dim">
      Figures describe the deployed network architecture. Trained-policy benchmarks will be published after
      on-silicon validation.
    </p>
  </div>
</section>

<style>
  .pipe-line {
    background: linear-gradient(90deg, transparent, rgba(196, 243, 107, 0.35), transparent);
    background-size: 200% 100%;
    animation: pipe 4s linear infinite;
  }
  @keyframes pipe {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -100% 0;
    }
  }
</style>
