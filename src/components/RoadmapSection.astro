---
const momentum = [
  { date: 'Feb 2026', title: 'VU Amsterdam Demonstrator Lab', body: 'Accepted into the D-Lab — European deep-tech infrastructure, mentorship and AgriTech network.' },
  { date: 'May 2026', title: 'Research release v0.1.0', body: 'Full simulation, training and neuromorphic deployment pipeline released and version-tagged.' },
  { date: '2026', title: 'On-silicon validation', body: 'Policy moves from simulation onto Akida hardware, with power measured on real chips.' },
];

const phases = [
  {
    phase: 'Phase 0',
    when: 'Oct 2025 – Jun 2026',
    title: 'Digital twin & training pipeline',
    items: ['Scientifically grounded lettuce + climate simulator', 'RL → distillation → quantisation → SNN toolchain', 'Pre-registered benchmark protocol'],
    status: 'done',
  },
  {
    phase: 'Phase 1',
    when: '2026',
    title: 'Neuromorphic hardware in the lab',
    items: ['Akida AKD1000 + Raspberry Pi 5 edge node at VU D-Lab', 'Silicon-level power measurement', 'Peer-reviewed publication'],
    status: 'now',
  },
  {
    phase: 'Phase 1.5',
    when: 'Next',
    title: 'Spiking vision on the same chip',
    items: ['Camera-based disease detection', 'Biomass estimation', 'Vision as direct control feedback'],
    status: 'next',
  },
  {
    phase: 'Phase 2',
    when: '2027+',
    title: 'Multi-crop, field pilots & partners',
    items: ['Multiple plants and cultivars', 'Partner deployments beyond the lab', 'Full LED-spectrum control'],
    status: 'next',
  },
];
---

<section id="roadmap" class="section">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px hairline" aria-hidden="true"></div>
  <div class="page">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-end">
      <div data-reveal>
        <span class="eyebrow">Traction & roadmap</span>
        <h2 class="h2 mt-6">From simulation <span class="accent-serif">to the soil.</span></h2>
      </div>
      <p class="lede" data-reveal style="--d:100ms">
        A staged path that de-risks the hardest part first: proving that one learned spiking policy can control
        a living crop on neuromorphic silicon.
      </p>
    </div>

    <!-- Momentum -->
    <div class="mt-16 grid gap-3 md:grid-cols-3">
      {momentum.map((m, i) => (
        <div class="card p-7" data-reveal style={`--d:${i * 90}ms`}>
          <div class="font-mono text-sm text-nf-signal">{m.date}</div>
          <h3 class="mt-3 text-lg font-medium tracking-tight">{m.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-nf-muted">{m.body}</p>
        </div>
      ))}
    </div>

    <!-- Phases -->
    <ol class="relative mt-16 grid gap-10 md:grid-cols-4 md:gap-4">
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/10 md:left-0 md:right-0 md:top-[7px] md:bottom-auto md:h-px md:w-auto" aria-hidden="true">
        <div class="progress absolute left-0 top-0 h-[40%] w-full bg-gradient-to-b from-nf-signal to-transparent md:h-full md:w-[40%] md:bg-gradient-to-r"></div>
      </div>
      {phases.map((p, i) => (
        <li class="relative pl-10 md:pl-0 md:pt-10" data-reveal style={`--d:${i * 100}ms`}>
          <span class={`absolute left-0 top-0.5 flex h-[15px] w-[15px] items-center justify-center rounded-full border ${
            p.status === 'done' ? 'border-nf-signal bg-nf-signal' : p.status === 'now' ? 'border-nf-signal bg-nf-ink' : 'border-white/20 bg-nf-ink'
          }`}>
            {p.status === 'now' && <span class="absolute h-full w-full animate-ping rounded-full bg-nf-signal/50"></span>}
            {p.status === 'now' && <span class="h-1.5 w-1.5 rounded-full bg-nf-signal"></span>}
          </span>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">{p.phase}</span>
            {p.status === 'done' && <span class="rounded-full bg-nf-signal/10 px-2 py-0.5 font-mono text-[0.62rem] uppercase text-nf-signal">Complete</span>}
            {p.status === 'now' && <span class="rounded-full bg-nf-amber/10 px-2 py-0.5 font-mono text-[0.62rem] uppercase text-nf-amber">In progress</span>}
          </div>
          <h3 class="mt-3 text-lg font-medium tracking-tight">{p.title}</h3>
          <div class="mt-1 font-mono text-xs text-nf-dim">{p.when}</div>
          <ul class="mt-4 space-y-2 text-sm text-nf-muted">
            {p.items.map((it) => (
              <li class="flex gap-2.5"><span class="mt-[0.55rem] h-px w-2.5 flex-none bg-white/30"></span>{it}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <!-- Vision -->
    <div class="card relative mt-16 overflow-hidden p-8 md:p-12" data-reveal>
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-nf-signal/10 blur-3xl" aria-hidden="true"></div>
      <div class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">Long-term vision</div>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-2xl font-medium tracking-tight md:text-4xl">
        <span>Vertical farm</span>
        <span class="text-nf-dim">→</span>
        <span>Greenhouse</span>
        <span class="text-nf-dim">→</span>
        <span>Open field</span>
        <span class="text-nf-dim">→</span>
        <span class="accent-serif">Space agriculture.</span>
      </div>
      <p class="mt-5 max-w-2xl leading-relaxed text-nf-muted">
        Wherever food must grow with scarce energy, scarce water and no reliable connection, an offline brain is
        not a feature — it is the only option.
      </p>
    </div>
  </div>
</section>
