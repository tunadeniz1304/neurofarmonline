---
---

<div class="hero-animation-container relative w-full" style="max-width: 900px; margin: 0 auto;">
  <svg
    viewBox="0 0 900 400"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto"
    id="hero-svg"
  >
    <defs>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id="chipGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id="energyGlow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Stem gradient -->
      <linearGradient id="stemGrad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#1A5C38" />
        <stop offset="40%" stop-color="#2E7D52" />
        <stop offset="100%" stop-color="#4CAF50" />
      </linearGradient>

      <linearGradient id="leafGradDark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#2E7D52" />
        <stop offset="100%" stop-color="#4CAF50" />
      </linearGradient>
      <linearGradient id="leafGradLight" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4CAF50" />
        <stop offset="100%" stop-color="#A8E06C" />
      </linearGradient>

      <linearGradient id="flowGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#4CAF50" stop-opacity="0.2" />
        <stop offset="50%" stop-color="#4CAF50" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#D4A843" stop-opacity="0.2" />
      </linearGradient>

      <!-- Energy conduit gradient -->
      <linearGradient id="conduitGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#D4A843" stop-opacity="0.5" />
        <stop offset="40%" stop-color="#A8E06C" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#2E7D52" stop-opacity="0.2" />
      </linearGradient>
    </defs>

    <!-- ===== SENSOR NODES (Left) ===== -->
    <g class="sensors" transform="translate(30, 80)">
      <g transform="translate(0, 0)">
        <rect x="0" y="20" width="50" height="35" rx="4" fill="#1a3a28" stroke="#4CAF50" stroke-width="1" opacity="0.8" />
        <line x1="25" y1="0" x2="25" y2="20" stroke="#4CAF50" stroke-width="1.5" opacity="0.6" />
        <line x1="18" y1="0" x2="32" y2="0" stroke="#4CAF50" stroke-width="1.5" opacity="0.6" />
        <circle cx="12" cy="32" r="3" class="sensor-led" fill="#4CAF50" />
        <circle cx="25" cy="32" r="3" class="sensor-led" fill="#A8E06C" />
        <circle cx="38" cy="32" r="3" class="sensor-led" fill="#4CAF50" />
        <text x="25" y="48" text-anchor="middle" fill="#4CAF50" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.7">SOIL</text>
      </g>
      <g transform="translate(0, 100)">
        <rect x="0" y="20" width="50" height="35" rx="4" fill="#1a3a28" stroke="#4CAF50" stroke-width="1" opacity="0.8" />
        <line x1="25" y1="0" x2="25" y2="20" stroke="#4CAF50" stroke-width="1.5" opacity="0.6" />
        <circle cx="15" cy="8" r="5" fill="none" stroke="#4CAF50" stroke-width="1" opacity="0.5" />
        <circle cx="12" cy="32" r="3" class="sensor-led" fill="#A8E06C" />
        <circle cx="25" cy="32" r="3" class="sensor-led" fill="#4CAF50" />
        <circle cx="38" cy="32" r="3" class="sensor-led" fill="#A8E06C" />
        <text x="25" y="48" text-anchor="middle" fill="#4CAF50" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.7">TEMP</text>
      </g>
      <g transform="translate(0, 200)">
        <rect x="0" y="20" width="50" height="35" rx="4" fill="#1a3a28" stroke="#4CAF50" stroke-width="1" opacity="0.8" />
        <line x1="25" y1="0" x2="25" y2="20" stroke="#4CAF50" stroke-width="1.5" opacity="0.6" />
        <line x1="15" y1="5" x2="35" y2="5" stroke="#4CAF50" stroke-width="1" opacity="0.5" />
        <circle cx="12" cy="32" r="3" class="sensor-led" fill="#4CAF50" />
        <circle cx="25" cy="32" r="3" class="sensor-led" fill="#4CAF50" />
        <circle cx="38" cy="32" r="3" class="sensor-led" fill="#A8E06C" />
        <text x="25" y="48" text-anchor="middle" fill="#4CAF50" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.7">pH</text>
      </g>
    </g>

    <!-- ===== DATA FLOW PATHS (Sensors → Chip) ===== -->
    <path id="flow-path-1" d="M 105,117 C 180,117 250,160 370,185" fill="none" stroke="url(#flowGrad)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5" />
    <path id="flow-path-2" d="M 105,217 C 200,217 280,200 370,195" fill="none" stroke="url(#flowGrad)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5" />
    <path id="flow-path-3" d="M 105,317 C 200,317 280,240 370,205" fill="none" stroke="url(#flowGrad)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5" />

    <circle r="4" class="data-dot" style="offset-path: path('M 105,117 C 180,117 250,160 370,185');">
      <animate attributeName="r" values="3;5;3" dur="3s" repeatCount="indefinite" />
    </circle>
    <circle r="4" class="data-dot" style="offset-path: path('M 105,117 C 180,117 250,160 370,185'); animation-delay: 1.5s;"></circle>
    <circle r="4" class="data-dot" style="offset-path: path('M 105,217 C 200,217 280,200 370,195'); animation-delay: 0.3s;"></circle>
    <circle r="4" class="data-dot" style="offset-path: path('M 105,217 C 200,217 280,200 370,195'); animation-delay: 1.8s;"></circle>
    <circle r="4" class="data-dot" style="offset-path: path('M 105,317 C 200,317 280,240 370,205'); animation-delay: 0.7s;"></circle>
    <circle r="4" class="data-dot" style="offset-path: path('M 105,317 C 200,317 280,240 370,205'); animation-delay: 2.2s;"></circle>

    <!-- ===== NEUROMORPHIC CHIP (Center) ===== -->
    <g class="chip" transform="translate(370, 150)">
      <rect x="-5" y="-5" width="130" height="100" rx="10" fill="rgba(212, 168, 67, 0.1)" filter="url(#chipGlow)" />
      <rect class="chip-body" x="0" y="0" width="120" height="90" rx="8" fill="#1a2a20" stroke="#D4A843" stroke-width="2" />
      <line x1="-12" y1="20" x2="0" y2="20" stroke="#D4A843" stroke-width="2" />
      <line x1="-12" y1="40" x2="0" y2="40" stroke="#D4A843" stroke-width="2" />
      <line x1="-12" y1="60" x2="0" y2="60" stroke="#D4A843" stroke-width="2" />
      <line x1="-12" y1="80" x2="0" y2="80" stroke="#D4A843" stroke-width="2" />
      <line x1="120" y1="20" x2="132" y2="20" stroke="#D4A843" stroke-width="2" />
      <line x1="120" y1="40" x2="132" y2="40" stroke="#D4A843" stroke-width="2" />
      <line x1="120" y1="60" x2="132" y2="60" stroke="#D4A843" stroke-width="2" />
      <line x1="120" y1="80" x2="132" y2="80" stroke="#D4A843" stroke-width="2" />
      <line x1="30" y1="-12" x2="30" y2="0" stroke="#D4A843" stroke-width="2" />
      <line x1="50" y1="-12" x2="50" y2="0" stroke="#D4A843" stroke-width="2" />
      <line x1="70" y1="-12" x2="70" y2="0" stroke="#D4A843" stroke-width="2" />
      <line x1="90" y1="-12" x2="90" y2="0" stroke="#D4A843" stroke-width="2" />
      <line x1="30" y1="90" x2="30" y2="102" stroke="#D4A843" stroke-width="2" />
      <line x1="50" y1="90" x2="50" y2="102" stroke="#D4A843" stroke-width="2" />
      <line x1="70" y1="90" x2="70" y2="102" stroke="#D4A843" stroke-width="2" />
      <line x1="90" y1="90" x2="90" y2="102" stroke="#D4A843" stroke-width="2" />
      <path class="chip-circuit" d="M 20,20 L 40,20 L 40,40 L 60,40" fill="none" stroke="#4CAF50" stroke-width="1" opacity="0.6" />
      <path class="chip-circuit" d="M 80,20 L 80,35 L 100,35" fill="none" stroke="#A8E06C" stroke-width="1" opacity="0.6" style="animation-delay: 1.3s;" />
      <path class="chip-circuit" d="M 20,60 L 50,60 L 50,70 L 80,70" fill="none" stroke="#4CAF50" stroke-width="1" opacity="0.6" style="animation-delay: 1.6s;" />
      <path class="chip-circuit" d="M 60,50 L 100,50 L 100,65" fill="none" stroke="#A8E06C" stroke-width="1" opacity="0.6" style="animation-delay: 1.9s;" />
      <circle cx="40" cy="20" r="3" fill="#4CAF50" opacity="0.8" />
      <circle cx="80" cy="20" r="3" fill="#A8E06C" opacity="0.8" />
      <circle cx="60" cy="45" r="4" fill="#D4A843" opacity="0.9" />
      <circle cx="40" cy="60" r="3" fill="#4CAF50" opacity="0.8" />
      <circle cx="100" cy="50" r="3" fill="#A8E06C" opacity="0.8" />
      <text x="60" y="85" text-anchor="middle" fill="#D4A843" font-family="JetBrains Mono, monospace" font-size="11" font-weight="bold" letter-spacing="2">SNN</text>
    </g>

    <!-- ===== ENERGY CONDUIT (Chip → Plant) ===== -->
    <!-- Visible organic energy path from chip right-side output to plant base -->
    <path id="energy-conduit"
          d="M 502,195 C 545,195 580,220 620,260 C 650,290 680,330 700,360"
          fill="none" stroke="url(#conduitGrad)" stroke-width="3" stroke-linecap="round"
          class="energy-conduit" />
    <!-- Subtle inner glow line -->
    <path d="M 502,195 C 545,195 580,220 620,260 C 650,290 680,330 700,360"
          fill="none" stroke="#A8E06C" stroke-width="1.5" stroke-linecap="round"
          class="energy-conduit-inner" opacity="0.15" />

    <!-- Energy pulses traveling along the conduit path -->
    <circle r="5" fill="#A8E06C" filter="url(#energyGlow)" class="energy-pulse pulse-1"
            style="offset-path: path('M 502,195 C 545,195 580,220 620,260 C 650,290 680,330 700,360');" />
    <circle r="4" fill="#D4A843" filter="url(#energyGlow)" class="energy-pulse pulse-2"
            style="offset-path: path('M 502,195 C 545,195 580,220 620,260 C 650,290 680,330 700,360');" />
    <circle r="6" fill="#A8E06C" filter="url(#energyGlow)" class="energy-pulse pulse-3"
            style="offset-path: path('M 502,195 C 545,195 580,220 620,260 C 650,290 680,330 700,360');" />
    <circle r="3" fill="#4CAF50" filter="url(#glow)" class="energy-pulse pulse-4"
            style="offset-path: path('M 502,195 C 545,195 580,220 620,260 C 650,290 680,330 700,360');" />

    <!-- ===== PLANT (Right) ===== -->
    <g class="plant" transform="translate(700, 30)">
      <!-- Ground -->
      <line x1="-55" y1="330" x2="55" y2="330" stroke="#2E7D52" stroke-width="2" opacity="0.3" />

      <!-- Roots -->
      <path d="M 0,330 Q -14,350 -32,360" fill="none" stroke="#2E7D52" stroke-width="2.5" opacity="0.25" class="plant-root root-1" />
      <path d="M 0,330 Q 4,352 -12,368" fill="none" stroke="#2E7D52" stroke-width="2" opacity="0.2" class="plant-root root-2" />
      <path d="M 0,330 Q 16,350 34,362" fill="none" stroke="#2E7D52" stroke-width="2.5" opacity="0.25" class="plant-root root-3" />

      <!-- Main stem — thick, leans slightly left, taller -->
      <path d="M 0,330 C -1,295 0,265 -2,235 C -3,205 -2,178 -5,150 C -7,122 -8,95 -12,68 C -14,50 -18,30 -22,10"
            fill="none" stroke="url(#stemGrad)" stroke-width="5.5" stroke-linecap="round" class="plant-stem main-stem" />

      <!-- Branch stubs growing from stem -->
      <line x1="0" y1="280" x2="12" y2="272" stroke="#2E7D52" stroke-width="3" stroke-linecap="round" class="branch branch-1" />
      <line x1="-1" y1="245" x2="-14" y2="237" stroke="#2E7D52" stroke-width="3" stroke-linecap="round" class="branch branch-2" />
      <line x1="-2" y1="210" x2="12" y2="202" stroke="#2E7D52" stroke-width="3" stroke-linecap="round" class="branch branch-3" />
      <line x1="-4" y1="175" x2="-16" y2="166" stroke="#4CAF50" stroke-width="2.5" stroke-linecap="round" class="branch branch-4" />
      <line x1="-5" y1="142" x2="8" y2="133" stroke="#4CAF50" stroke-width="2.5" stroke-linecap="round" class="branch branch-5" />
      <line x1="-7" y1="110" x2="-20" y2="101" stroke="#4CAF50" stroke-width="2.5" stroke-linecap="round" class="branch branch-6" />
      <line x1="-9" y1="80" x2="4" y2="71" stroke="#4CAF50" stroke-width="2" stroke-linecap="round" class="branch branch-7" />
      <line x1="-11" y1="52" x2="-22" y2="43" stroke="#A8E06C" stroke-width="2" stroke-linecap="round" class="branch branch-8" />

      <!-- Leaves — each grows outward from its branch point -->
      <!-- Leaf 1: right, lowest -->
      <g class="leaf-grow leaf-grow-1" style="transform-origin: 0px 280px;">
        <path d="M 12,272 C 30,260 54,258 66,268 C 54,275 30,278 12,280" fill="url(#leafGradDark)" stroke="#2E7D52" stroke-width="0.5" />
        <path d="M 12,276 C 28,268 48,266 63,271" fill="none" stroke="#1A5C38" stroke-width="0.5" opacity="0.4" />
      </g>

      <!-- Leaf 2: left -->
      <g class="leaf-grow leaf-grow-2" style="transform-origin: -1px 245px;">
        <path d="M -14,237 C -34,225 -58,224 -70,234 C -56,241 -34,243 -14,245" fill="url(#leafGradDark)" stroke="#2E7D52" stroke-width="0.5" />
        <path d="M -14,241 C -32,233 -52,231 -67,237" fill="none" stroke="#1A5C38" stroke-width="0.5" opacity="0.4" />
      </g>

      <!-- Leaf 3: right -->
      <g class="leaf-grow leaf-grow-3" style="transform-origin: -2px 210px;">
        <path d="M 12,202 C 32,190 58,188 70,198 C 56,205 32,208 12,210" fill="url(#leafGradDark)" stroke="#2E7D52" stroke-width="0.5" />
        <path d="M 12,206 C 30,198 50,196 67,201" fill="none" stroke="#1A5C38" stroke-width="0.5" opacity="0.4" />
      </g>

      <!-- Leaf 4: left -->
      <g class="leaf-grow leaf-grow-4" style="transform-origin: -4px 175px;">
        <path d="M -16,166 C -36,154 -62,153 -74,163 C -60,170 -36,172 -16,175" fill="url(#leafGradLight)" stroke="#4CAF50" stroke-width="0.5" />
        <path d="M -16,170 C -34,163 -56,161 -71,166" fill="none" stroke="#2E7D52" stroke-width="0.5" opacity="0.3" />
      </g>

      <!-- Leaf 5: right -->
      <g class="leaf-grow leaf-grow-5" style="transform-origin: -5px 142px;">
        <path d="M 8,133 C 26,122 52,120 64,130 C 50,137 26,140 8,142" fill="url(#leafGradLight)" stroke="#4CAF50" stroke-width="0.5" />
        <path d="M 8,137 C 24,130 46,128 61,133" fill="none" stroke="#2E7D52" stroke-width="0.5" opacity="0.3" />
      </g>

      <!-- Leaf 6: left -->
      <g class="leaf-grow leaf-grow-6" style="transform-origin: -7px 110px;">
        <path d="M -20,101 C -40,90 -64,89 -74,99 C -60,106 -40,108 -20,110" fill="url(#leafGradLight)" stroke="#4CAF50" stroke-width="0.5" />
        <path d="M -20,105 C -38,98 -58,96 -71,101" fill="none" stroke="#2E7D52" stroke-width="0.5" opacity="0.3" />
      </g>

      <!-- Leaf 7: right, upper -->
      <g class="leaf-grow leaf-grow-7" style="transform-origin: -9px 80px;">
        <path d="M 4,71 C 20,61 42,60 52,69 C 40,75 20,77 4,80" fill="#A8E06C" stroke="#4CAF50" stroke-width="0.5" />
        <path d="M 4,75 C 18,69 36,67 49,72" fill="none" stroke="#4CAF50" stroke-width="0.5" opacity="0.25" />
      </g>

      <!-- Leaf 8: left, upper -->
      <g class="leaf-grow leaf-grow-8" style="transform-origin: -11px 52px;">
        <path d="M -22,43 C -38,33 -58,32 -66,41 C -54,47 -38,49 -22,52" fill="#A8E06C" stroke="#4CAF50" stroke-width="0.5" />
        <path d="M -22,47 C -36,41 -52,39 -63,44" fill="none" stroke="#4CAF50" stroke-width="0.5" opacity="0.25" />
      </g>

      <!-- Top leaf — the stem tip becomes this leaf, same size as other leaves -->
      <g class="leaf-grow leaf-grow-9" style="transform-origin: -22px 10px;">
        <path d="M -22,10 C -28,-2 -36,-18 -34,-30 C -26,-22 -16,-10 -10,0 C -14,4 -18,8 -22,10 Z" fill="#A8E06C" stroke="#4CAF50" stroke-width="0.5" opacity="0.9" />
        <path d="M -22,10 C -27,-4 -34,-18 -34,-30" fill="none" stroke="#4CAF50" stroke-width="0.5" opacity="0.3" />
      </g>
    </g>

    <!-- ===== LABELS ===== -->
    <text x="55" y="385" text-anchor="middle" fill="#4CAF50" font-family="JetBrains Mono, monospace" font-size="9" opacity="0.6">SENSORS</text>
    <text x="430" y="385" text-anchor="middle" fill="#D4A843" font-family="JetBrains Mono, monospace" font-size="9" opacity="0.6">NEUROMORPHIC CHIP</text>
    <text x="700" y="385" text-anchor="middle" fill="#A8E06C" font-family="JetBrains Mono, monospace" font-size="9" opacity="0.6">AUTONOMOUS GROWTH</text>
  </svg>

  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none hidden md:block"></canvas>
</div>

<style>
  @import '../styles/hero-animation.css';
</style>
