---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const sections = [
  { label: 'Problem', href: '#problem' },
  { label: 'Technology', href: '#technology' },
  { label: 'Science', href: '#science' },
  { label: 'Market', href: '#market' },
  { label: 'Roadmap', href: '#roadmap' },
  { label: 'Team', href: '#team' },
  { label: 'Contact', href: '#contact' },
];
---

<footer class="relative overflow-hidden border-t border-white/[0.06]">
  <div class="page py-12">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <a href="#hero" class="flex items-center gap-2.5" aria-label="NeuroFarm home">
          <Logo class="h-7 w-7" />
          <span class="font-semibold tracking-tight">NeuroFarm</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-nf-muted">Neuromorphic edge AI for autonomous, low-energy crop control.</p>
      </div>
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-1 sm:grid-cols-4">
        {sections.map(({ label, href }) => (
          <a href={href} class="inline-flex min-h-[40px] items-center text-sm text-nf-muted transition-colors hover:text-nf-text">{label}</a>
        ))}
      </nav>
    </div>
    <div class="hairline my-8"></div>
    <div class="flex flex-col gap-4 text-sm text-nf-dim sm:flex-row sm:items-center sm:justify-between">
      <span>&copy; {year} NeuroFarm · Amsterdam</span>
      <div class="flex items-center gap-5">
        <a href="mailto:info@neurofarm.nl" class="transition-colors hover:text-nf-text">info@neurofarm.nl</a>
        <a href="https://linkedin.com/company/neurofarm" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 transition-colors hover:text-nf-text" aria-label="NeuroFarm on LinkedIn">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="pointer-events-none select-none text-center font-medium leading-none tracking-tightest text-white/[0.03] text-[22vw]" aria-hidden="true">neurofarm</div>
</footer>
