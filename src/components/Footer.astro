---
const year = new Date().getFullYear();
const sections = [
  { label: 'Problem', href: '#problem' },
  { label: 'Solution', href: '#solution' },
  { label: 'Technology', href: '#technology' },
  { label: 'Market', href: '#market' },
  { label: 'Roadmap', href: '#roadmap' },
  { label: 'Team', href: '#team' },
  { label: 'Contact', href: '#contact' },
];
---

<footer class="bg-nf-dark border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 bg-nf-primary rounded-md flex items-center justify-center">
          <span class="text-nf-lime font-bold text-xs">N</span>
        </div>
        <span class="text-white font-bold tracking-tight">NeuroFarm</span>
        <span class="text-gray-600 text-sm ml-2">&copy; {year}</span>
      </div>

      <!-- Links -->
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {sections.map(({ label, href }) => (
          <a href={href} class="text-sm text-gray-500 hover:text-gray-300 transition-colors">{label}</a>
        ))}
      </nav>

      <!-- Social + Domain -->
      <div class="flex items-center gap-4">
        <a href="https://linkedin.com/company/neurofarm" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <span class="text-gray-600 text-sm font-mono">neurofarm.nl</span>
      </div>
    </div>
  </div>
</footer>
