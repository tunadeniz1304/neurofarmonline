---
const team = [
  {
    name: 'Tuna Deniz',
    role: 'Co-Founder & Technical Lead',
    expertise: 'Spiking Neural Network (SNN) Architecture, Neuromorphic Hardware Integration, Edge Computing',
    initials: 'TD',
    linkedin: 'https://linkedin.com/in/tuna-deniz1304',
  },
  {
    name: 'Cihan Ozturk',
    role: 'Co-Founder & Business Lead',
    expertise: 'Strategy, Operations, and European Market Expansion',
    initials: 'CO',
    linkedin: 'https://www.linkedin.com/in/cihanozturk0/',
  },
];
---

<section id="team" class="py-20 md:py-28 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-nf-accent font-mono text-sm font-medium tracking-wider uppercase">Leadership</span>
      <h2 class="section-heading mt-3">The Founders</h2>
      <p class="section-subheading mx-auto mt-4">
        Combined expertise spanning silicon-level AI engineering to pan-European go-to-market strategy.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      {team.map((member, i) => (
        <div class="reveal" style={`transition-delay: ${i * 150}ms`}>
          <div class="p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300 text-center group">
            <!-- Avatar placeholder -->
            <div class="w-24 h-24 rounded-full bg-nf-dark mx-auto mb-5 flex items-center justify-center group-hover:bg-nf-primary transition-colors">
              <span class="text-nf-lime font-bold text-2xl">{member.initials}</span>
            </div>

            <h3 class="text-xl font-bold text-nf-text">{member.name}</h3>
            <p class="text-nf-accent font-medium text-sm mt-1">{member.role}</p>
            <p class="text-gray-500 text-sm mt-3 leading-relaxed">{member.expertise}</p>
            <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-4 text-nf-accent hover:text-nf-primary transition-colors text-sm font-medium">
              <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
