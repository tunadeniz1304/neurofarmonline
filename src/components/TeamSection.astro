---
const team = [
  {
    name: 'Tuna Deniz',
    role: 'Co-Founder & Technical Lead',
    expertise: ['Spiking neural networks', 'Neuromorphic hardware', 'Reinforcement learning', 'Edge computing'],
    initials: 'TD',
    linkedin: 'https://linkedin.com/in/tuna-deniz1304',
  },
  {
    name: 'Cihan Ozturk',
    role: 'Co-Founder & Business Lead',
    expertise: ['Strategy', 'Operations', 'European market expansion'],
    initials: 'CO',
    linkedin: 'https://www.linkedin.com/in/cihanozturk0/',
  },
];
---

<section id="team" class="section">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px hairline" aria-hidden="true"></div>
  <div class="page">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div data-reveal>
        <span class="eyebrow">Founders</span>
        <h2 class="h2 mt-6">Silicon-level AI, <span class="accent-serif">meets the market.</span></h2>
        <p class="lede mt-6">
          A founding team spanning neuromorphic engineering and pan-European go-to-market — based in Amsterdam,
          hosted by the VU Demonstrator Lab.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {team.map((m, i) => (
          <article class="card group flex flex-col p-7 transition-colors duration-300 hover:border-white/15" data-reveal style={`--d:${i * 100}ms`}>
            <div class="relative h-16 w-16">
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-nf-signal/30 to-nf-leaf/10 blur-md transition-opacity duration-300 group-hover:opacity-100 opacity-50"></div>
              <div class="relative flex h-full w-full items-center justify-center rounded-2xl border border-white/10 bg-nf-surface font-mono text-lg text-nf-signal">
                {m.initials}
              </div>
            </div>
            <h3 class="mt-6 text-xl font-medium tracking-tight">{m.name}</h3>
            <p class="mt-1 text-sm text-nf-signal">{m.role}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {m.expertise.map((e) => <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-nf-muted">{e}</span>)}
            </div>
            <a
              href={m.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto inline-flex min-h-[44px] items-center gap-2 pt-6 text-sm text-nf-muted transition-colors hover:text-nf-text"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              LinkedIn
              <span class="sr-only">profile of {m.name} (opens in new tab)</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
