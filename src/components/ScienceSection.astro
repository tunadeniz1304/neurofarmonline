---
const facts = [
  { value: '9', label: 'Hypotheses pre-registered', body: 'Committed to version control on 10 May 2026 — before a single benchmark result existed.' },
  { value: '210', label: 'Benchmark runs', body: '20 seeds per headline comparison, tested with Wilcoxon, Cliff’s δ and Holm–Bonferroni correction.' },
  { value: '47', label: 'Cited crop parameters', body: 'Every value in the plant model traces to a DOI. Nothing hand-tuned to flatter the result.' },
  { value: '366', label: 'Automated tests', body: 'Continuous integration across simulator, training, quantisation and deployment code.' },
];

const baselines = ['PID controller', 'Rule-based controller', 'Timer schedule'];
---

<section id="science" class="section">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px hairline" aria-hidden="true"></div>
  <div class="page">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <span class="eyebrow">Scientific rigour</span>
        <h2 class="h2 mt-6">
          Built to be <span class="accent-serif">audited,</span> not just demoed.
        </h2>
        <p class="lede mt-6">
          Deep-tech claims deserve evidence. NeuroFarm is benchmarked against the controllers growers use today,
          with the statistics locked in before the data came in.
        </p>

        <div class="card mt-10 p-5 font-mono text-[0.78rem] leading-7">
          <div class="flex items-center justify-between text-nf-dim">
            <span>git log --grep="pre-registration"</span>
            <span class="text-nf-leaf">✓ verified</span>
          </div>
          <div class="hairline my-3"></div>
          <div><span class="text-nf-amber">commit</span> <span class="text-nf-dim">· 2026-05-10</span></div>
          <div class="text-nf-text">pre-register hypothesis family H1–H9</div>
          <div class="text-nf-dim">tests: wilcoxon · cliffs_delta · holm_bonferroni</div>
          <div class="text-nf-dim">baselines: {baselines.map((b) => b.split(' ')[0].toLowerCase()).join(' · ')}</div>
        </div>
      </div>

      <div>
        <div class="grid gap-3 sm:grid-cols-2">
          {facts.map((f, i) => (
            <div class="card p-7" data-reveal style={`--d:${i * 80}ms`}>
              <div class="font-mono text-5xl font-medium tracking-tight text-nf-text"><span data-count={f.value}>{f.value}</span></div>
              <div class="mt-3 text-nf-signal">{f.label}</div>
              <p class="mt-2 text-sm leading-relaxed text-nf-muted">{f.body}</p>
            </div>
          ))}
        </div>

        <div class="card mt-3 p-7" data-reveal>
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div>
              <div class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">Benchmarked against</div>
              <div class="mt-3 flex flex-wrap gap-2">
                {baselines.map((b) => <span class="rounded-full border border-white/10 px-3.5 py-1.5 text-sm text-nf-text">{b}</span>)}
              </div>
            </div>
            <div class="md:text-right">
              <div class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">Energy reporting</div>
              <p class="mt-3 max-w-xs text-sm leading-relaxed text-nf-muted md:ml-auto">
                Measured on real silicon with inline power metering and reported as honest ranges — never a single
                cherry-picked number.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          <div class="card p-5" data-reveal><div class="font-mono text-2xl">25+</div><div class="mt-1 text-sm text-nf-muted">Architecture decision records</div></div>
          <div class="card p-5" data-reveal style="--d:80ms"><div class="font-mono text-2xl">v0.1.0</div><div class="mt-1 text-sm text-nf-muted">Research release, May 2026</div></div>
          <div class="card p-5" data-reveal style="--d:160ms"><div class="font-mono text-2xl">4</div><div class="mt-1 text-sm text-nf-muted">Stress scenarios per evaluation</div></div>
        </div>
      </div>
    </div>
  </div>
</section>
