<section id="traction" class="py-20 md:py-28 bg-nf-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-nf-lime font-mono text-sm font-medium tracking-wider uppercase">Traction</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mt-3">Where We Are</h2>
    </div>

    <!-- D-Lab Feature Card -->
    <div class="reveal max-w-3xl mx-auto">
      <div class="p-8 md:p-12 rounded-2xl bg-gradient-to-br from-nf-primary/20 to-nf-dark border border-nf-primary/30">
        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10">
          <!-- Badge -->
          <div class="flex-shrink-0 w-24 h-24 rounded-2xl bg-white/10 flex items-center justify-center border border-white/20">
            <div class="text-center">
              <div class="text-nf-lime font-bold text-2xl">VU</div>
              <div class="text-white/60 text-xs font-mono">D-LAB</div>
            </div>
          </div>

          <div class="text-center md:text-left">
            <div class="text-nf-lime font-mono text-sm font-medium mb-2">February 2026</div>
            <h3 class="text-xl md:text-2xl font-bold text-white mb-3">
              VU Amsterdam Demonstrator Lab
            </h3>
            <p class="text-gray-400 leading-relaxed">
              Accepted into the prestigious VU Amsterdam D-Lab — a European deep-tech acceleration program providing world-class research infrastructure, mentorship networks, and a premier AgriTech ecosystem.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Status -->
    <div class="reveal mt-10 text-center">
      <p class="text-gray-400">
        Currently in <span class="text-nf-lime font-semibold">active prototyping and testing</span> within the European deep-tech ecosystem.
      </p>
    </div>
  </div>
</section>
