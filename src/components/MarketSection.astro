---
const markets = [
  { segment: 'Precision agriculture', v24: 8.5, v30: 19.2, cagr: '~14.5%' },
  { segment: 'Edge AI hardware', v24: 4.1, v30: 24.7, cagr: '~35%' },
  { segment: 'Neuromorphic computing', v24: 0.5, v30: 9.8, cagr: '~62%' },
];
const max = 25;

const path = [
  { stage: 'Beachhead', title: 'Indoor & vertical farms', body: 'Controlled environments where water and energy per kilogram are measured — and paid for — every day.' },
  { stage: 'Expand', title: 'Commercial greenhouses', body: 'A learned, offline controller alongside or in place of rule-based climate computers.' },
  { stage: 'Scale', title: 'Open field', body: 'Autonomous nodes where connectivity is weakest and precision matters most.' },
];

const drivers = [
  'EU Green Deal pressure on agricultural water, fertiliser and energy use',
  'Food security demand in climate-stressed, low-infrastructure regions',
  'Rapidly falling cost of neuromorphic and low-power edge AI chips',
  'Strategic institutional focus on deep-tech AgriTech in Europe',
];
---

<section id="market" class="section">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px hairline" aria-hidden="true"></div>
  <div class="page">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow">Opportunity</span>
      <h2 class="h2 mt-6">Three markets, <span class="accent-serif">one intersection.</span></h2>
      <p class="lede mt-6">
        Sustainable farming, edge AI and neuromorphic computing are each growing on independent tailwinds.
        NeuroFarm sits exactly where they meet.
      </p>
    </div>

    <div class="mt-16 grid gap-3 lg:grid-cols-[1.25fr_1fr]">
      <!-- Chart -->
      <div class="card p-7 md:p-9" data-reveal>
        <div class="flex items-center justify-between">
          <h3 class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">Global market size, USD bn</h3>
          <div class="flex items-center gap-4 font-mono text-[0.68rem] text-nf-dim">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-white/25"></span>2024</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-nf-signal"></span>2030</span>
          </div>
        </div>

        <div class="mt-10 space-y-9" id="market-bars">
          {markets.map((m, i) => (
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-nf-text">{m.segment}</span>
                <span class="font-mono text-sm text-nf-signal">CAGR {m.cagr}</span>
              </div>
              <div class="relative mt-3 h-9">
                <div class="mbar absolute inset-y-0 left-0 rounded-md bg-gradient-to-r from-nf-leaf/70 to-nf-signal" style={`--w:${(m.v30 / max) * 100}%; --d:${i * 150}ms`}></div>
                <div class="mbar absolute inset-y-0 left-0 rounded-md bg-white/25" style={`--w:${(m.v24 / max) * 100}%; --d:${i * 150}ms`}></div>
                <span class="absolute inset-y-0 left-0 flex items-center justify-end pr-3 font-mono text-sm font-medium text-nf-ink" style={`width:${(m.v30 / max) * 100}%`}>${m.v30}B</span>
              </div>
              <div class="mt-1.5 font-mono text-[0.7rem] text-nf-dim">${m.v24}B in 2024</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Drivers -->
      <div class="card p-7 md:p-9" data-reveal style="--d:100ms">
        <h3 class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">Tailwinds</h3>
        <ul class="mt-6 space-y-5">
          {drivers.map((d, i) => (
            <li class="flex gap-4">
              <span class="font-mono text-xs text-nf-signal">0{i + 1}</span>
              <span class="leading-relaxed text-nf-muted">{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Go-to-market path -->
    <div class="mt-3 grid gap-3 md:grid-cols-3">
      {path.map((p, i) => (
        <div class="card relative p-7" data-reveal style={`--d:${i * 90}ms`}>
          <div class="flex items-center gap-3">
            <span class={`h-2 w-2 rounded-full ${i === 0 ? 'bg-nf-signal shadow-[0_0_12px_#C4F36B]' : 'bg-white/20'}`}></span>
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-nf-dim">{p.stage}</span>
          </div>
          <h3 class="mt-5 text-xl font-medium tracking-tight">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-nf-muted">{p.body}</p>
          {i < path.length - 1 && (
            <svg class="absolute -right-3 top-1/2 z-10 hidden h-6 w-6 -translate-y-1/2 text-nf-dim md:block" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" /></svg>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mbar {
    width: var(--w);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.4s var(--ease-out) var(--d);
  }
  :global(#market-bars.is-in) .mbar {
    transform: scaleX(1);
  }
</style>

<script>
  const el = document.getElementById('market-bars');
  if (el) {
    new IntersectionObserver(
      ([entry], obs) => {
        if (entry.isIntersecting) {
          el.classList.add('is-in');
          obs.disconnect();
        }
      },
      { threshold: 0.4 },
    ).observe(el);
  }
</script>
