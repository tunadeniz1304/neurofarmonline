---
---

<section id="contact" class="py-20 md:py-28 bg-nf-dark">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 reveal">
      <span class="text-nf-lime font-mono text-sm font-medium tracking-wider uppercase">Contact</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mt-3">Get in Touch</h2>
      <p class="text-lg text-gray-400 mt-4">
        Interested in NeuroFarm? Let's talk about the future of agriculture.
      </p>
    </div>

    <div class="reveal grid md:grid-cols-2 gap-10">
      <!-- Contact Form -->
      <form action="https://formspree.io/f/mjgapvpo" method="POST" class="space-y-5">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-300 mb-1">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:border-nf-accent focus:ring-1 focus:ring-nf-accent outline-none transition-colors"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:border-nf-accent focus:ring-1 focus:ring-nf-accent outline-none transition-colors"
            placeholder="your@email.com"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-gray-300 mb-1">Message</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:border-nf-accent focus:ring-1 focus:ring-nf-accent outline-none transition-colors resize-none"
            placeholder="Tell us about your interest..."
          ></textarea>
        </div>
        <button type="submit" class="btn-primary w-full justify-center">
          Send Message
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- Contact Info -->
      <div class="flex flex-col justify-center space-y-8">
        <div>
          <h3 class="text-white font-semibold mb-2">Email</h3>
          <a href="mailto:info@neurofarm.nl" class="text-nf-lime hover:text-nf-accent transition-colors">
            info@neurofarm.nl
          </a>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-2">Location</h3>
          <p class="text-gray-400">Amsterdam, Netherlands</p>
          <p class="text-gray-500 text-sm mt-1">VU Amsterdam Demonstrator Lab</p>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-2">Website</h3>
          <a href="https://neurofarm.nl" class="text-nf-lime hover:text-nf-accent transition-colors">
            neurofarm.nl
          </a>
        </div>

        <!-- Quote -->
        <div class="p-6 rounded-xl bg-nf-primary/20 border border-nf-primary/30">
          <p class="text-white italic text-sm leading-relaxed">
            "The future of agriculture isn't just connected — it's conscious."
          </p>
          <p class="text-nf-lime/60 text-xs mt-2 font-mono">— NeuroFarm</p>
        </div>
      </div>
    </div>
  </div>
</section>
