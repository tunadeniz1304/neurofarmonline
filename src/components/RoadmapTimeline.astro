---
const milestones = [
  {
    period: 'Q1–Q2 2026',
    title: 'Prototype Development & Lab Validation',
    description: 'SNN model training, hardware integration on neuromorphic chip, sensor fusion validation under controlled conditions.',
    status: 'current',
  },
  {
    period: 'Q3 2026',
    title: 'Field Pilot',
    description: 'Deployment of first NeuroFarm nodes in a partner agricultural environment; performance benchmarking vs. cloud-based alternatives.',
    status: 'upcoming',
  },
  {
    period: 'Q4 2026',
    title: 'Commercial Partnerships & Series A',
    description: 'Formalise pilot outcomes, initiate strategic partnerships with AgriTech distributors, begin fundraising process.',
    status: 'upcoming',
  },
  {
    period: '2027+',
    title: 'Scale & Expand',
    description: 'Multi-region European rollout, hardware miniaturisation, and exploration of adjacent verticals.',
    status: 'future',
  },
];
---

<section id="roadmap" class="py-20 md:py-28 bg-nf-neutral">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-nf-accent font-mono text-sm font-medium tracking-wider uppercase">Roadmap</span>
      <h2 class="section-heading mt-3">What's Next</h2>
    </div>

    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-0.5 bg-nf-primary/20 -translate-x-1/2"></div>

      <div class="space-y-12">
        {milestones.map((milestone, i) => (
          <div class="reveal relative" style={`transition-delay: ${i * 150}ms`}>
            <div class={`flex items-start gap-6 md:gap-12 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
              <!-- Timeline dot -->
              <div class="absolute left-6 md:left-1/2 -translate-x-1/2 z-10">
                <div class={`w-4 h-4 rounded-full border-2 ${
                  milestone.status === 'current'
                    ? 'bg-nf-accent border-nf-accent animate-pulse'
                    : milestone.status === 'upcoming'
                      ? 'bg-white border-nf-primary'
                      : 'bg-white border-gray-300'
                }`}></div>
              </div>

              <!-- Content -->
              <div class={`ml-14 md:ml-0 md:w-[calc(50%-2rem)] ${i % 2 === 1 ? 'md:text-right' : ''}`}>
                <div class="p-6 rounded-xl bg-white border border-gray-100 hover:shadow-lg transition-shadow">
                  <span class={`font-mono text-sm font-bold ${
                    milestone.status === 'current' ? 'text-nf-accent' : 'text-gray-400'
                  }`}>
                    {milestone.period}
                  </span>
                  <h3 class="text-lg font-bold text-nf-text mt-1 mb-2">{milestone.title}</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">{milestone.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
