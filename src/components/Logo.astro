---
interface Props {
  class?: string;
}
const { class: className = 'h-7 w-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect x="0.5" y="0.5" width="31" height="31" rx="9" fill="#0F1E16" stroke="#1E3328" />
  <!-- Stem / sprout that doubles as a neuron axon -->
  <path d="M16 25V14" stroke="#3FD18A" stroke-width="1.8" stroke-linecap="round" />
  <path d="M16 17c-3.6 0-6-2.3-6-6 3.6 0 6 2.3 6 6Z" fill="#3FD18A" />
  <path d="M16 14.5c0-3.7 2.4-6.5 6-6.5 0 3.7-2.4 6.5-6 6.5Z" fill="#C4F36B" />
  <!-- Spike nodes -->
  <circle cx="16" cy="25" r="2.2" fill="#C4F36B" />
  <circle cx="9.5" cy="25" r="1.2" fill="#93A89A" />
  <circle cx="22.5" cy="25" r="1.2" fill="#93A89A" />
</svg>
