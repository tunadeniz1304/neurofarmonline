---
const metrics = [
  {
    value: '<1',
    suffix: ' ms',
    label: 'Inference Latency',
    description: 'Instantaneous on-chip response',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
  {
    value: '~mW',
    suffix: '',
    label: 'Power per Node',
    description: 'Ultra-low energy deployment',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>`,
  },
  {
    value: '0',
    suffix: '%',
    label: 'Cloud Dependency',
    description: 'Fully offline, autonomous AI',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4l16 16" /></svg>`,
  },
];
---

<section id="solution" class="py-20 md:py-28 bg-nf-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-nf-lime font-mono text-sm font-medium tracking-wider uppercase">The Solution</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mt-3">Intelligence at the Edge</h2>
      <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mt-4">
        NeuroFarm brings the processor to the plant. By eliminating the cloud, we remove latency, energy overhead, and connectivity dependency in a single architectural shift.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {metrics.map((metric, i) => (
        <div class="reveal" style={`transition-delay: ${i * 150}ms`}>
          <div class="relative p-8 rounded-2xl bg-gradient-to-b from-white/5 to-transparent border border-white/10 hover:border-nf-accent/30 transition-all duration-300 text-center group">
            <div class="text-nf-accent mb-4 flex justify-center group-hover:text-nf-lime transition-colors">
              <Fragment set:html={metric.icon} />
            </div>
            <div class="font-mono text-4xl md:text-5xl font-bold text-white mb-2" data-counter={metric.value} data-suffix={metric.suffix}>
              {metric.value}{metric.suffix}
            </div>
            <div class="text-nf-lime font-semibold text-lg mb-1">{metric.label}</div>
            <div class="text-gray-500 text-sm">{metric.description}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
