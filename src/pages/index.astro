---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import StatusBar from '../components/sections/StatusBar.astro';
import Problem from '../components/sections/Problem.astro';
import System from '../components/sections/System.astro';
import Rigour from '../components/sections/Rigour.astro';
import Roadmap from '../components/sections/Roadmap.astro';
import Market from '../components/sections/Market.astro';
import Team from '../components/sections/Team.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <span id="top"></span>
    <Hero />
    <StatusBar />
    <Problem />
    <System />
    <Rigour />
    <Roadmap />
    <Market />
    <Team />
    <Contact />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
